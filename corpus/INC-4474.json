{
  "bundle_version": "1.0",
  "incident_id": "INC-4474",
  "slice": "cascading_dependency",
  "title": "Checkout 5xx eight minutes after a deploy — but this time the upstream really did lead",

  "ground_truth": {
    "root_cause_id": "H2",
    "summary": "inventory-service p99 latency began climbing at 10:01 and sustained, saturating checkout's calls and cascading into 5xx. A checkout deploy (v4.01.0) landed at 10:00 and only tweaked a client timeout; rolling it back does NOT fix the upstream. This is the genuine cascade — the structural mirror of INC-4471, where an early upstream blip was a coincidence. The discriminator is identical (the ordering of the upstream signal) and lives only in probeable.",
    "rollback_correct": false
  },

  "human_baseline_seconds": 2400,

  "alert": {
    "service": "checkout-service",
    "environment": "production",
    "severity": "SEV-2",
    "fired_at": "2026-07-11T10:08:10Z",
    "signal": "http_5xx_rate",
    "condition": "error rate 8.0% > threshold 2%",
    "source": "pagerduty"
  },

  "topology": {
    "nodes": ["checkout-service", "orders-db", "inventory-service"],
    "edges": [
      { "from": "checkout-service", "to": "orders-db" },
      { "from": "checkout-service", "to": "inventory-service" }
    ]
  },

  "observables": [
    { "name": "inventory_p99_latency", "unit": "ms",  "desc": "upstream inventory-service p99 latency" },
    { "name": "cpu_utilization",       "unit": "pct", "desc": "checkout-service pod CPU" },
    { "name": "error_type_breakdown",  "unit": "map", "desc": "checkout errors grouped by exception class" }
  ],

  "seed_hypotheses": [
    {
      "id": "H1",
      "claim": "The 10:00 deploy v4.01.0 changed a DB timeout and broke checkout; roll it back.",
      "natural_owner": "change_agent",
      "predicted_observations": [
        { "observable": "inventory_p99_latency", "prediction": "rises_later", "note": "if the deploy is the cause, upstream inventory latency is a downstream/coincidental signal that lags" }
      ]
    },
    {
      "id": "H2",
      "claim": "Upstream inventory-service degraded first and cascaded downstream into checkout.",
      "natural_owner": "telemetry_agent",
      "predicted_observations": [
        { "observable": "inventory_p99_latency", "prediction": "rises_first", "note": "upstream latency leads the whole cascade" }
      ]
    }
  ],

