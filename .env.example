# Copy this file to `.env` and fill in your real keys.
# `.env` is gitignored and must NEVER be committed. This template is safe to commit.

# --- Master switch: does the agent loop call a real model? -------------------
#   0 (default) -> deterministic analytical engine only; runs fully offline, no key.
#   1           -> agents reason via ic/llm.py (needs a real key below).
# The HARNESS always runs deterministic regardless, so ablation numbers stay reproducible.
IC_USE_LLM=0

# --- Iteration / free tier (get from https://openrouter.ai -> Keys) ---
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# --- Final quality pass (get from https://console.anthropic.com -> API Keys) ---
# Optional: only needed when you run IC_PROVIDER=anthropic for a strong-model check.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Which provider ic/llm.py uses. One of: openrouter_free | openrouter_pinned | anthropic ---
#   openrouter_free    -> model "openrouter/free" (resilient auto-router; use while tuning prompts)
#   openrouter_pinned  -> a single fixed free slug (use for the harness so numbers are reproducible)
#   anthropic          -> Claude direct (final quality confirmation)
IC_PROVIDER=openrouter_free

# The slug used when IC_PROVIDER=openrouter_pinned. Verify it's still ":free" at openrouter.ai/models.
IC_PINNED_MODEL=openai/gpt-oss-120b:free

# The Claude model used when IC_PROVIDER=anthropic. Check current docs for the exact string.
IC_ANTHROPIC_MODEL=claude-sonnet-5
